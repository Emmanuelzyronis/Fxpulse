# FXPulse environment variables (all optional — the app runs with zero keys).

# Optional CoinGecko Demo API key. Without it the app uses the keyless public API
# (lower rate limits). With it, requests go to the Demo endpoint with a higher ceiling.
# COINGECKO_DEMO_API_KEY=

# Optional override for the CoinGecko base URL (advanced/testing).
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional override for the Frankfurter base URL (advanced/testing).
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
